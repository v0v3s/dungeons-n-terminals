{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/v0v3s/dungeons-n-terminals" },
        { "url": "https://github.com/v0v3s/dungeons-n-terminals/*" }
      ]
    }
  ]
}
