{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dnt",
  "identifier": "cz.v0v3s.dnt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Dungeons & Terminals",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#1a1b26"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "dnt-app"
}
